// -*- mode: dts -*-
/*
 * Rolio encoder-pin hunt. NOT a usable layout.
 *
 * Replaces the key matrix with a direct kscan over every pin the E73 module
 * exposes that the verified configuration does NOT already use:
 *
 *   P0.03 P0.06 P0.08 P0.10 P0.12 P0.24 P0.26 P1.06 P1.10
 *
 * Each is a pull-up input, active low. A rotary encoder shorts its A and B
 * lines to ground as it turns, so rotating the roller should register as
 * "key presses" on exactly the two pins it is wired to.
 *
 *   a=P0.03  b=P0.06  c=P0.08  d=P0.10  e=P0.12
 *   f=P0.24  g=P0.26  h=P1.06  i=P1.10
 *
 * Excluded: P1.11 (peripheral power, must stay driven), P0.18 (RESET), and
 * everything already claimed by the matrix, SPI buses, PWM, LED and battery.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan_direct;
        zmk,physical-layout = &encdiag_layout;
    };

    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    encdiag_transform: encdiag_transform {
        compatible = "zmk,matrix-transform";
        columns = <9>;
        rows = <1>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8)>;
    };

    encdiag_layout: encdiag_layout {
        compatible = "zmk,physical-layout";
        display-name = "encdiag";
        kscan = <&kscan_direct>;
        transform = <&encdiag_transform>;
        keys
            = <&key_physical_attrs 100 100    0 0 0 0 0>, <&key_physical_attrs 100 100  100 0 0 0 0>
            , <&key_physical_attrs 100 100  200 0 0 0 0>, <&key_physical_attrs 100 100  300 0 0 0 0>
            , <&key_physical_attrs 100 100  400 0 0 0 0>, <&key_physical_attrs 100 100  500 0 0 0 0>
            , <&key_physical_attrs 100 100  600 0 0 0 0>, <&key_physical_attrs 100 100  700 0 0 0 0>
            , <&key_physical_attrs 100 100  800 0 0 0 0>
            ;
    };

    keymap {
        compatible = "zmk,keymap";
        encdiag_layer {
            display-name = "encdiag";
            bindings = <&kp A &kp B &kp C &kp D &kp E &kp F &kp G &kp H &kp I>;
        };
    };
};

/* Free P0.03 and P1.10 from the encoder driver so the direct kscan owns them. */
&encoder_left  { status = "disabled"; };
&encoder_right { status = "disabled"; };
