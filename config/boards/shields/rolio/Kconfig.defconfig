# SPDX-License-Identifier: MIT

if SHIELD_ROLIO_LEFT

config ZMK_KEYBOARD_NAME
    default "Rolio Three"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_ROLIO_LEFT

if SHIELD_ROLIO_LEFT || SHIELD_ROLIO_RIGHT

config ZMK_SPLIT
    default y

config ZMK_POINTING
    default y

endif

if ZMK_BACKLIGHT

# The "backlight" PWM channel gates power to the underglow strip.
config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT
