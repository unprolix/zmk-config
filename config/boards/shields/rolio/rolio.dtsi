/*
 * Rolio ("Rolio Three") — shared shield devicetree.
 *
 * Pin assignments come from MickiusMousius/Rolio2Firmware branch `main`
 * (7-column matrix), NOT the choc2-revision* branches. Confirmed empirically
 * against this hardware on 2026-08-21 with a supermatrix diagnostic that
 * scanned every candidate pin from every branch at once:
 *
 *   rows  P0.31 P0.29 P0.02 P0.28
 *   cols  P1.02 P0.07 P0.04 P1.09 P0.05 P1.04 P0.09   (left, outer -> inner)
 *
 * The choc2-revision* branches use six columns on P0.05/P0.08/P1.09/P0.04/
 * P0.07/P0.24 with row3 on P1.13; on this board P0.08 and P0.24 are not wired
 * to the matrix at all, and P1.13 drives the underglow power gate.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include "rolio-layout.dtsi"

&rolio_layout {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};

/ {
    /*
     * Swaps which emblem the vista508 shows. Declared HERE, in the shared
     * dtsi, rather than in vista508.overlay: only the left half carries the
     * display, but both halves compile the same keymap, so a node visible to
     * only one of them fails the other's build outright. The behaviour is a
     * no-op on the half with no screen -- see emblem_toggle.c.
     */
    behaviors {
        emblem_toggle: emblem_toggle {
            compatible = "zmk,behavior-emblem-toggle";
            #binding-cells = <0>;
        };
    };

    chosen {
        zmk,physical-layout = &rolio_layout;
        zmk,kscan = &kscan0;
        zmk,underglow = &led_strip;
        zmk,backlight = &underglow_power;
    };

    /*
     * 48 positions, but only six columns of keycaps. Column 6 holds just the
     * roller's push switch (RC(2,6) left / RC(2,7) right) and the wide inner
     * thumb key (RC(3,6) / RC(3,7)). Row 3 is the bottom row of four plus
     * that thumb key.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                    RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)   RC(2,7)  RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)   RC(3,7)  RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    /* Rows are the same on both halves; the halves mirror in the columns. */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * Roller encoders, one per half. P0.03 / P1.10 per the `main` branch.
     * P0.03 was previously claimed by EXT_POWER in the vendor's board file,
     * which is why these were disabled; the display's real power enable turned
     * out to be P1.11, freeing P0.03 for its actual purpose. Untested at the
     * time of writing -- verify the roller before trusting these.
     */
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    encoder_right: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    /*
     * Registers the encoders with the keymap so `sensor-bindings` reach them.
     * Sensor index 0 is the left roller, 1 is the right; each half enables only
     * its own encoder, but both must be listed here so the indices line up
     * across the split.
     */
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left &encoder_right>;
        triggers-per-rotation = <15>;
    };

    /* Not a backlight: this PWM channel gates power to the underglow strip. */
    underglow_power: underglow_power {
        compatible = "pwm-leds";
        underglow_power {
            pwms = <&pwm0 0 10000 PWM_POLARITY_NORMAL>;
        };
    };

    /* The right half owns the trackpad; the central receives its events
       through this split-input proxy. The right overlay fills in `device`. */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* Enabled by rolio_left.overlay: only the central turns trackpad events
       into pointer movement. zip_scroll_scaler is ZMK's own, from
       zmk/app/dts/input/processors/scaler.dtsi. */
    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
        input-processors = <&zip_xy_scaler 1 1>;

        scroller {
            layers = <8>;    /* NAVIGATION held -> trackpad scrolls */
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 20
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            >;
        };
    };
};

&i2c0 {
    status = "disabled";
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            /* P0.27 is not connected on the e73 module and is high speed. */
            psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
                <NRF_PSEL(SPIM_MOSI, 0, 13)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
                <NRF_PSEL(SPIM_MOSI, 0, 13)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        chain-length = <23>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};
