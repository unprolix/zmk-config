/*
 * Ergohaven Omega Point 36, shared by both halves and the Qube dongle.
 *
 * Pins and matrix order come from the vendor's ZMK shield
 * (ergohaven/ergohaven-zmk boards/shields/op36, 2026.03.16) and agree with
 * their RMK firmware (ergohaven/rmk keyboards/classic_qube, v0.1.8).
 *
 * Each half is a 3x6 matrix: columns 0-4 are the main keys, column 5 is the
 * three thumb keys. The left half's main columns run outer-to-inner as 4..0;
 * the right half's run inner-to-outer as 0..4, offset to 6..10.
 *
 * The transform is the 42-position layout the shared keymap is written against
 * (zmk-helpers key-labels/42.h), exactly as on the Toucan. The OP36 has no outer
 * pinky column, so those six positions map to row 3, which no kscan here ever
 * reports; the keymap binds them &none. This keeps every key-label -- combos,
 * hold-trigger positions -- pointing at the right physical key.
 *
 * All three parts must carry this identical transform.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#define OP36_COLUMNS 12
#define OP36_ROWS 4

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <OP36_COLUMNS>;
        rows = <OP36_ROWS>;
        map = <
RC(3,0) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(3,11)
RC(3,1) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(3,10)
RC(3,2) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(3,9)
                        RC(0,5) RC(1,5) RC(2,5)    RC(2,11) RC(1,11) RC(0,11)
        >;
    };
};
