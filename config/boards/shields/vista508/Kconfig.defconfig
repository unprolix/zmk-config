# SPDX-License-Identifier: MIT

if SHIELD_VISTA508

config ZMK_DISPLAY
    default y

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

# The vendor's custom LVGL status screen (animations, WPM chart, pairing view)
# is not ported; ZMK's built-in screen needs no widget C in the config dir.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
endchoice

# 144x168 is ~2.2x the pixel count of a nice!view; give LVGL more headroom.
# NOTE: an earlier `default` elsewhere wins over this one, so the effective
# value is set in vista508.conf instead -- a .conf assignment beats defaults.
config LV_Z_MEM_POOL_SIZE
    default 8192

# Rotation is handled by the driver's rotate-180 property, not by LVGL.
config LS0XX_VCOM_THREAD_PRIO
    default 11

endif # SHIELD_VISTA508
