/* bt-modsel.dtsi
 *
 * Defines BT_MODSEL(idx) macro:
 * - Shift+key → &bt BT_DISC idx
 * - Alt+key   → &bt BT_CLR idx
 * - Else      → &bt BT_SEL idx
 *
 * Usage:
 *   BT_MODSEL(0)
 *   BT_MODSEL(1)
 *   ...
 * Then bind keys with:
 *   &bt_modsel_0
 *   &bt_modsel_1
 */

#define BT_MODSEL(idx)                                                   \
    / {                                                                  \
        behaviors {                                                      \
            bt_sel_##idx: bt_sel_##idx {                                 \
                compatible = "zmk,behavior-macro";                       \
                #binding-cells = <0>;                                    \
                bindings = <&bt BT_SEL_CMD idx>;                         \
            };                                                           \
                                                                         \
            bt_disc_##idx: bt_disc_##idx {                               \
                compatible = "zmk,behavior-macro";                       \
                #binding-cells = <0>;                                    \
                bindings = <&bt BT_DISC_CMD idx>;                        \
            };                                                           \
                                                                         \
            bt_clr_##idx: bt_clr_##idx {                                 \
                compatible = "zmk,behavior-macro";                       \
                #binding-cells = <0>;                                    \
                bindings = <&bt BT_CLR_CMD idx>;                         \
            };                                                           \
                                                                         \
            bt_alt_##idx: bt_alt_##idx {                                 \
                compatible = "zmk,behavior-mod-morph";                   \
                #binding-cells = <0>;                                    \
                bindings = <&bt_sel_##idx>, <&bt_clr_##idx>;             \
                mods = <(MOD_LALT|MOD_RALT)>;                            \
            };                                                           \
                                                                         \
            bt_shift_##idx: bt_shift_##idx {                             \
                compatible = "zmk,behavior-mod-morph";                   \
                #binding-cells = <0>;                                    \
                bindings = <&bt_alt_##idx>, <&bt_disc_##idx>;            \
                mods = <(MOD_LSFT|MOD_RSFT)>;                            \
            };                                                           \
                                                                         \
            bt_modsel_##idx: bt_modsel_##idx {                           \
                compatible = "zmk,behavior-macro";                       \
                #binding-cells = <0>;                                    \
                bindings = <&bt_shift_##idx>;                            \
            };                                                           \
        };                                                               \
    };
