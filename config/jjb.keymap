// ******************************************  BLUETOOTH layer


		
#define BLUETOOTH_LZ &trans &trans &trans &trans &trans &trans
// ZMK_BLE_PROFILE_COUNT = BT_MAX_PAIRED(6) - SPLIT_PERIPHERALS(1) = 5, so the
// valid profiles are 0-4 and the old `BT_SEL 5` here was a dead key. Raising
// CONFIG_BT_MAX_PAIRED to 7 would give a sixth, at the cost of re-pairing.
#define BLUETOOTH_LT_IN &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
#define BLUETOOTH_LT &bt BT_SEL 0  BLUETOOTH_LT_IN
#define BLUETOOTH_LM_IN &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bt BT_DISC 5
#define BLUETOOTH_LM &bt BT_DISC 0  BLUETOOTH_LM_IN
#define BLUETOOTH_LB_IN &trans  &trans  &trans  &trans  &trans
#define BLUETOOTH_LB &bt BT_CLR  BLUETOOTH_LB_IN
#define BLUETOOTH_LH &trans &trans &to HIEROPHANT
#define BLUETOOTH_LH_5 &trans &trans BLUETOOTH_LH

#define BLUETOOTH_RZ &trans &trans &trans &trans &trans &trans
// Output routing. Without these there is no way to force USB or BLE: with both
// connected ZMK picks USB, and nothing in this config could override that.
//                       force USB      force BLE      toggle
#define BLUETOOTH_RT_IN &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans
#define BLUETOOTH_RT BLUETOOTH_RT_IN  &trans
#define BLUETOOTH_RM_IN &trans  &trans  &trans  &trans  &trans
#define BLUETOOTH_RM BLUETOOTH_RM_IN  &trans
#define BLUETOOTH_RB_IN &trans  &trans  &trans  &trans  &trans
#define BLUETOOTH_RB BLUETOOTH_RB_IN  &trans
#define BLUETOOTH_RH &to HIEROPHANT &trans &trans
#define BLUETOOTH_RH_5 &trans &trans BLUETOOTH_RH


		
// ****************************************** SUPERSCRIPT layer
//
// Each letter position emits the Unicode superscript of the letter that sits
// there on the hierophant base layer. Everything else -- backspace, enter,
// mods, punctuation, the thumbs -- stays &trans so it keeps working while the
// layer is on; without that the layer would be a trap.
//
// Enter with LEADER S U P E R (leader.dtsi), leave with either inner thumb,
// matching how the LGN/RGN layers exit.
//
// NOTE: the original design in alphanumerics.dtsi took a different route --
// per-letter "smart_*" morphs behind #ifdef SUPERSCRIPT_REALLY, emitting the
// superscript only while this layer was active. That depends on
// zmk,behavior-layer-morph-fixed, which does not exist in ZMK or in any module
// here, so it could never have compiled. Doing it as a plain layer needs no
// new behaviour.
//
// q is deliberately &trans: Unicode has no superscript q in the modifier-letter
// block that the rest of these come from, so it falls through and types a
// normal q rather than emitting something no font will render.

#define SUP_A &uc 0x1D43 0     // ᵃ
#define SUP_B &uc 0x1D47 0     // ᵇ
#define SUP_C &uc 0x1D9C 0     // ᶜ
#define SUP_D &uc 0x1D48 0     // ᵈ
#define SUP_E &uc 0x1D49 0     // ᵉ
#define SUP_F &uc 0x1DA0 0     // ᶠ
#define SUP_G &uc 0x1D4D 0     // ᵍ
#define SUP_H &uc 0x02B0 0     // ʰ
#define SUP_I &uc 0x2071 0     // ⁱ
#define SUP_J &uc 0x02B2 0     // ʲ
#define SUP_K &uc 0x1D4F 0     // ᵏ
#define SUP_L &uc 0x02E1 0     // ˡ
#define SUP_M &uc 0x1D50 0     // ᵐ
#define SUP_N &uc 0x207F 0     // ⁿ
#define SUP_O &uc 0x1D52 0     // ᵒ
#define SUP_P &uc 0x1D56 0     // ᵖ
#define SUP_R &uc 0x02B3 0     // ʳ
#define SUP_S &uc 0x02E2 0     // ˢ
#define SUP_T &uc 0x1D57 0     // ᵗ
#define SUP_U &uc 0x1D58 0     // ᵘ
#define SUP_V &uc 0x1D5B 0     // ᵛ
#define SUP_W &uc 0x02B7 0     // ʷ
#define SUP_X &uc 0x02E3 0     // ˣ
#define SUP_Y &uc 0x02B8 0     // ʸ
#define SUP_Z &uc 0x1DBB 0     // ᶻ

#define SUPERSCRIPT_LZ &trans &trans &trans &trans &trans &trans
#define SUPERSCRIPT_RZ &trans &trans &trans &trans &trans &trans

//                         f      z      u      q(none)  bspc
#define SUPERSCRIPT_LT_IN SUP_F  SUP_Z  SUP_U  &trans   &trans
#define SUPERSCRIPT_LT &trans  SUPERSCRIPT_LT_IN
//                         w      d      l      b
#define SUPERSCRIPT_RT_IN &trans  SUP_W  SUP_D  SUP_L  SUP_B
#define SUPERSCRIPT_RT SUPERSCRIPT_RT_IN  &trans

// Home row keeps its mods, mirroring hierophant: h=LGUI i=LALT e=LSHIFT a=LCTRL.
#define SUPERSCRIPT_LM_IN &hml_sup L_M4 0x02B0  &hml_sup L_M3 0x2071  &hml_sup L_M2 0x1D49  &hml_sup L_M1 0x1D43  SUP_P
#define SUPERSCRIPT_LM &trans  SUPERSCRIPT_LM_IN
// Mirrored on the right: s=RCTRL t=RSHIFT r=RALT n=RGUI.
#define SUPERSCRIPT_RM_IN SUP_G  &hmr_sup R_M1 0x02E2  &hmr_sup R_M2 0x1D57  &hmr_sup R_M3 0x02B3  &hmr_sup R_M4 0x207F
#define SUPERSCRIPT_RM SUPERSCRIPT_RM_IN  &trans

//                         ,      y      k      o      x
#define SUPERSCRIPT_LB_IN &trans  SUP_Y  SUP_K  SUP_O  SUP_X
#define SUPERSCRIPT_LB &trans  SUPERSCRIPT_LB_IN
//                         v      c      m      j      .
#define SUPERSCRIPT_RB_IN SUP_V  SUP_C  SUP_M  SUP_J  &trans
#define SUPERSCRIPT_RB SUPERSCRIPT_RB_IN  &trans

// Inner thumbs leave the layer, as in LGN/RGN.
#define SUPERSCRIPT_LH &trans &trans &to HIEROPHANT
#define SUPERSCRIPT_RH &to HIEROPHANT &trans &trans

#define SUPERSCRIPT_LH_5 &trans &trans SUPERSCRIPT_LH
#define SUPERSCRIPT_RH_5 &trans &trans SUPERSCRIPT_RH


// ******************************************  NUMPAD layer

#define NUMPAD_LZ &trans &trans &trans &trans &trans &trans
#define NUMPAD_LT_IN &kp N0  &kp N1  &kp N2  &kp N3  &kp QUESTION
#define NUMPAD_LT &kp BSLH  NUMPAD_LT_IN
#define NUMPAD_LM_IN &kp PLUS  &kp N4  &kp N5  &kp N6  &kp SQT
#define NUMPAD_LM &trans  NUMPAD_LM_IN
#define NUMPAD_LB_IN &kp DOT  &kp N7  &kp N8  &kp N9  &kp LESS_THAN
#define NUMPAD_LB &trans  NUMPAD_LB_IN
#define NUMPAD_LH &kp N0 &trans &trans
#define NUMPAD_LH_5 &trans &trans NUMPAD_LH


#define NUMPAD_RZ &trans   &trans &trans &trans  &trans     &trans
#define NUMPAD_RT_IN &kp N0  &kp N1  &kp N2  &kp N3  &kp MINUS
#define NUMPAD_RT NUMPAD_RT_IN  &kp FSLH
#define NUMPAD_RM_IN &kp DQT  &kp N4  &kp N5  &kp N6  &kp PLUS
#define NUMPAD_RM NUMPAD_RM_IN  &trans
#define NUMPAD_RB_IN &kp GREATER_THAN  &kp N7  &kp N8  &kp N9  &kp DOT
#define NUMPAD_RB NUMPAD_RB_IN  &trans
#define NUMPAD_RH &trans &trans &kp N0
#define NUMPAD_RH_5 &trans &trans NUMPAD_RH




