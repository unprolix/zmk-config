// ******************************************  LIGHTING layer
//
// Was the RGB layer, back when the lighting ran ZMK's underglow effects.
// rgbzone paints columns by what they do, so hue, saturation, effect and speed
// have nothing left to act on -- what remains worth reaching is whether the
// lights are on at all and how bright. Reached with leader L E D.
//
// On a board without rgbzone the keys go transparent rather than vanish, so
// the shared row macros stay usable there.

#ifdef RGBZONE_PRESENT
  #define LIGHT_TOG &rgbz_tog
  #define LIGHT_UP  &rgbz_up
  #define LIGHT_DN  &rgbz_dn
#else
  #define LIGHT_TOG &trans
  #define LIGHT_UP  &trans
  #define LIGHT_DN  &trans
#endif

#define LIGHTING_LZ &trans &trans &trans &trans &trans &trans
#define LIGHTING_RZ &trans &trans &trans &trans &trans &trans

// Toggle and brightness keep the keys the old on/off and brighter/dimmer had.
//                        on/off
#define LIGHTING_LT_IN LIGHT_TOG  &trans  &trans  &trans  &trans
#define LIGHTING_LT &trans  LIGHTING_LT_IN
#define LIGHTING_RT_IN &trans  &trans  &trans  &trans  &trans
#define LIGHTING_RT LIGHTING_RT_IN  &trans

//                        brighter   dimmer
#define LIGHTING_LM_IN LIGHT_UP  LIGHT_DN  &trans  &trans  &trans
#define LIGHTING_LM &trans  LIGHTING_LM_IN
#define LIGHTING_RM_IN &trans  &trans  &trans  &trans  &trans
#define LIGHTING_RM LIGHTING_RM_IN  &trans

#define LIGHTING_LB_IN &trans  &trans  &trans  &trans  &trans
#define LIGHTING_LB &trans  LIGHTING_LB_IN
#define LIGHTING_RB_IN &trans  &trans  &trans  &trans  &trans
#define LIGHTING_RB LIGHTING_RB_IN  &trans

// The layer is otherwise transparent, so without these there is no way back.
#define LIGHTING_LH &trans &trans &to HIEROPHANT
#define LIGHTING_RH &to HIEROPHANT &trans &trans 

#define LIGHTING_LH_5 &trans &trans LIGHTING_LH
#define LIGHTING_RH_5 &trans &trans LIGHTING_RH



