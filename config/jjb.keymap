#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>

#include <input/processors.dtsi>

#define HIEROPHANT 0
#define QWERTY 1
#define GAMING 2
// Slot 3 held the CAPS layer. Caps lock needs no layer -- the lighting
// reads the host's LED report -- but the numbering below it is shared with
// rolio.keymap and toucan.keymap, so the slot stays, empty.
#define EMPTY_2 3
#define SUPERSCRIPT 4

#define NUMERIC 5
#define NUMPAD 6
#define SYMBOL 7


#define NAVIGATION 8
#define MODIFIER_LEFT_NAV 9
#define MODIFIER_RIGHT_NAV 10

#define EXTRA 11
#define FN 12

#define LIGHTING 13
#define BLUETOOTH 14
#define SYSTEM 15


// short versions for helping things line up
#define NUM NUMERIC
#define NAV NAVIGATION
#define LGUI_NAV_L MODIFIER_LEFT_NAV
#define RGUI_NAV_R MODIFIER_RIGHT_NAV
#define MENU K_APPLICATION


// which modifiers we want on which home row keys
#define L_M4 LGUI
#define L_M3 LALT
#define L_M2 LSHIFT
#define L_M1 LCTRL
//#define L_M0 N/A

//#define L_M0 N/A
#define R_M1 RCTRL
#define R_M2 RSHIFT
#define R_M3 RALT
#define R_M4 RGUI



#define TAP_TIMEOUT 50
#define TAP_DANCE_TAPPING 250  	/* 200 seemed difficult to achieve */
#define FAST_TAP 230		// at 200, the double tap actions do not reliably trigger
#define INTERRUPT_TAP 50        // very short window, for interrupting tap dance
#define HRM_PAUSE 250           // required delay before a hrm will trigger (too big: 350)
#define LONG_PAUSE 500		// e.g. before certain combos. 800 is too long. so is 600
