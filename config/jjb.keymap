#define LGN_LT &kp LG(TAB)  LGN_LT_IN
#define LGN_LM_IN &trans  &hml L_M3 LG(I)  &hml L_M2 LG(E)  &hml L_M1(A)  &kp LG(P)
#define LGN_LM &trans  LGN_LM_IN
#define LGN_LB_IN &kp LG(COMMA)  &kp LG(Y)  &kp LG(K)  &kp LG(O)  &kp LG(X)
#define LGN_LB &kp LG(BSLH)  LGN_LB_IN
#define LGN_LH &kp LG(ESC)  &kp LG(TAB)  &to HIEROPHANT
#define LGN_LH_5 &trans &trans LGN_LH


#define LGN_RZ &trans &trans &trans &trans &trans &trans
#define LGN_RT_IN &msc LG(SCRL_UP)  &kp LG(HOME)  &kp LG(UP_ARROW)  &kp LG(END)  &kp LG(PG_UP)
#define LGN_RT LGN_RT_IN  &kp LG(BSPC)
