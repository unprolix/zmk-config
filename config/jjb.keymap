   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#define QUICK_TAP_MS 175



#include "macros.dtsi"



ZMK_HOLD_TAP(smart_num, bindings = <&mo>, <&num_dance>; flavor = "balanced";
             tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_TAP_DANCE(num_dance, bindings = <&num_word NUM>, <&sl NUM>;
              tapping-term-ms = <200>;)

// dedicated auto-layer behaviors so smart NUMPAD/SYMBOL stay active across their layer keys
/ {
    behaviors {
        numpad_word: numpad_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL BSLH SQT DQT QUESTION LESS_THAN GREATER_THAN>;
            ignore-numbers;
        };
        symbol_word: symbol_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BACKSPACE DELETE SPACE TAB ESC GRAVE TILDE EXCL AT HASH DOLLAR PERCENT CARET AMPS ASTERISK LPAR RPAR MINUS UNDERSCORE EQUAL PLUS LBKT RBKT LBRC RBRC BSLH PIPE SEMI COLON SQT DQT COMMA DOT LT GT FSLH QMARK>;
        };
    };
};



#define HRM_PRIOR_IDLE 150	// increased from 80 to fix inconsistent hold activation (particularly A->LCTRL). 80 was too low, causing holds to fail when typing quickly

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                    \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";               \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;            \
               require-prior-idle-ms = <HRM_PRIOR_IDLE>;                          \
               hold-trigger-key-positions = <TRIGGER_POS>;)

#define HRM_SYM_TAPPING_TERM 380
#define HRM_SYM_PRIOR_IDLE 250

#define MAKE_HRM_SYM(NAME, HOLD, TAP, TRIGGER_POS)                                    \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";                   \
               tapping-term-ms = <HRM_SYM_TAPPING_TERM>; quick-tap-ms = <QUICK_TAP_MS>; \
               require-prior-idle-ms = <HRM_SYM_PRIOR_IDLE>;                          \
               hold-trigger-key-positions = <TRIGGER_POS>;)

#define MAKE_ADAPTIVE_REPEAT(NAME, HOLD_TAP_BEHAVIOR, LAYER, KEY) \
		NAME: NAME { \
			compatible = "zmk,behavior-antecedent-morph"; \
			#binding-cells = <0>; \
			defaults = <&HOLD_TAP_BEHAVIOR LAYER KEY>; \
			bindings = <&key_repeat>; \
			antecedents = <KEY>; \
			max-delay-ms = <HRM_PAUSE>; \
		};

#define MAKE_ANTECEDENT_MORPH(NAME, DEFAULT_KEY, MORPH_KEY, ANTECEDENT_KEY) \
		NAME: NAME { \
			compatible = "zmk,behavior-antecedent-morph"; \
			#binding-cells = <0>; \
			defaults = <&kp DEFAULT_KEY>; \
			bindings = <&kp MORPH_KEY>; \
			antecedents = <ANTECEDENT_KEY>; \
			max-delay-ms = <HRM_PAUSE>; \
		};

#define MAKE_ANTECEDENT_MORPH_ADV(NAME, DEFAULT_BEHAVIOR, MORPH_BEHAVIOR, ANTECEDENT_KEY) \
		NAME: NAME { \
			compatible = "zmk,behavior-antecedent-morph"; \
			#binding-cells = <0>; \
			defaults = <DEFAULT_BEHAVIOR>; \
			bindings = <MORPH_BEHAVIOR>; \
			antecedents = <ANTECEDENT_KEY>; \
			max-delay-ms = <HRM_PAUSE>; \
		};



MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// SUPERSCRIPT home-row mods (&sup_uc lives in layer-mod-macros.dtsi): same timings as the ordinary HRMs, but tapping
// emits a superscript instead of a letter. Without these the SUPERSCRIPT layer
// would drop every home-row mod for as long as it is toggled on.
MAKE_HRM(hml_sup, &kp, &sup_uc, KEYS_R THUMBS)
MAKE_HRM(hmr_sup, &kp, &sup_uc, KEYS_L THUMBS)

MAKE_HRM_SYM(hml_sym, &kp, &kp, KEYS_R THUMBS) // SYMBOL-layer left HRMs (longer term, more prior-idle).
MAKE_HRM_SYM(hmr_sym, &kp, &kp, KEYS_L THUMBS) // SYMBOL-layer right HRMs.

// Top Layer Left/Right
MAKE_HRM(tll, &mo, &kp, KEYS_R THUMBS)
MAKE_HRM(tlr, &mo, &kp, KEYS_L THUMBS)

// Sticky variants of the above.
//
// The nav thumbs hold to &sl rather than &mo, which is why NAV can be held for
// one key and then let go of -- the layer survives exactly one press. Holding a
// layer down for the whole of a two-key sequence is the tiring way to do it.
//
// FUNCTION and EXTRA are reached the same way, so they get the same treatment;
// everything else about these matches tll/tlr, including the positional
// restriction that stops a same-hand roll being read as a hold.
MAKE_HRM(tll_sticky, &sl, &kp, KEYS_R THUMBS)
MAKE_HRM(tlr_sticky, &sl, &kp, KEYS_L THUMBS)

